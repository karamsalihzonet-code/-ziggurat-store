# Database
DB_USER=ziggurat_user
DB_HOST=localhost
DB_NAME=ziggurat_db
DB_PASSWORD=change-this-password
DB_PORT=5432

# Server
PORT=5000
NODE_ENV=development

# Security
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
